# Adresse du backend (back-end_chorale). Copiez ce fichier en .env.local puis adaptez.
# Sur un téléphone, « localhost » désigne le téléphone lui-même : utilisez l'adresse IP
# du PC sur le réseau Wi-Fi (commande `ipconfig`, ligne « Adresse IPv4 »).
# Émulateur Android : http://10.0.2.2:3000 · Simulateur iOS / navigateur : http://localhost:3000
EXPO_PUBLIC_API_URL=http://192.168.1.20:3000
